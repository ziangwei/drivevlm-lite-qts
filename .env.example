# Root folders on the server.
DRIVEVLM_DATA_DIR=/path/to/drivevlm-lite/data
DRIVEVLM_MODEL_DIR=/path/to/drivevlm-lite/models
DRIVEVLM_OUTPUT_DIR=/path/to/drivevlm-lite/outputs

# Hugging Face cache. Keep this outside Git.
HF_HOME=/path/to/drivevlm-lite/cache/huggingface
HF_HUB_CACHE=/path/to/drivevlm-lite/cache/huggingface/hub
HF_XET_CACHE=/path/to/drivevlm-lite/cache/huggingface/xet
HF_ASSETS_CACHE=/path/to/drivevlm-lite/cache/huggingface/assets
HF_DATASETS_CACHE=/path/to/drivevlm-lite/cache/huggingface/datasets
HF_XET_HIGH_PERFORMANCE=1

# Optional access token for gated Hugging Face datasets/models.
HF_TOKEN=
